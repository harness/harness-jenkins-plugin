<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Version}" field="version"
             description="Harness CLI version to install from github.com/harness/cli (e.g. 3.13.0). Leave empty to install the latest release.">
        <f:textbox/>
    </f:entry>
</j:jelly>
